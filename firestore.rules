rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ใส่อีเมลครูที่อนุญาตให้อัปโหลด/ลบเสียงได้ (ใส่ได้หลายอีเมล คั่นด้วยจุลภาค)
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email in ['ใส่อีเมลครูตรงนี้@gmail.com'];
    }

    // เสียงอ่านแต่ละคำ: ทุกคนฟังได้ เฉพาะครูแก้ไขได้
    match /voices/{key} {
      allow read: if true;
      allow write: if isTeacher()
        && (request.resource == null || request.resource.data.b64.size() < 1000000);
    }

    // รายการคำที่มีเสียงคน
    match /meta/{doc} {
      allow read: if true;
      allow write: if isTeacher();
    }
  }
}
